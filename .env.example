# Environment Variables for Invoice Handler

# Application
APP_NAME=Invoice Handler
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoice_handler
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LLM (using local model via Ollama or similar, or API if available)
# For this example, we assume a local LLM endpoint (like Ollama) or we can use API keys for cloud LLMs
# Since the spec says we are the LLM (Nemotron 3 Super or MiniMax M2.7), we'll set up for a local endpoint.
LLM_BASE_URL=http://localhost:11434  # Example for Ollama
LLM_MODEL=nemotron-3-super  # or minimax-m2.7, configurable

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Company Configuration (for Chaser Agent)
COMPANY_NAME=Your Company Name
SENDER_NAME=Accounts Receivable

# Rate Limiting (for reminder sending)
REMINDER_RATE_LIMIT_SECONDS=0.5

# Google API (for Gmail and Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/drive.readonly

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox  # or development, production
PLAID_PRODUCTS=transactions,assets
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK=http://localhost:8000/webhook/plaid

# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/auth/xero/callback
XERO_SCOPES=accounting.transactions,accounting.reports.read,accounting.contacts

# QuickBooks
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/auth/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox  # or production

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid (for Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Reporting
REPORT_GENERATION_TIME=0 0 * * 0  # Weekly at midnight Sunday (Cron expression)
ALERT_THRESHOLD_OVERDUE=1000  # Alert if overdue exceeds this amount

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# REQUIRED: Token Encryption (OAuth tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# REQUIRED: JWT Secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Checkpoint Configuration (for LangGraph workflow state persistence)
# Set to "false" to use in-memory checkpoints (dev only - state lost on restart)
CHECKPOINT_USE_POSTGRES=true

# LangChain/LangSmith Observability (Tier 1)
# Get your API key from https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=invoice-handler

# MFA Configuration (Multi-Factor Authentication)
# Set to "true" to enforce MFA for all users (PRODUCTION REQUIRED)
# Requires Clerk MFA to be configured in Clerk Dashboard
ENFORCE_MFA=true